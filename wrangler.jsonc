{
  "name": "darkmoon",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/u/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "darkmoon",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
