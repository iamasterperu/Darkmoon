{
  "name": "darkmoon",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/u/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "darkmoon",
      "database_id": "3a5fb865-c148-485f-89c6-bab5ce22f7cc"
    }
  ]
}
